# ─── DATABASE ───
# Opção LOCAL (desenvolvimento):
DATABASE_URL=file:./db/custom.db
#
# Opção PRODUÇÃO na Vercel (Turso — SQLite cloud gratuito):
# 1. Crie em https://turso.tech (plano free)
# 2. Crie um database: turso db create refugio-db
# 3. Pegue a URL: turso db show refugio-db --url
# 4. Crie auth token: turso db tokens create refugio-db
#
# Formato Turso (ambos funcionam):
# DATABASE_URL=libsql://refugio-db-usuario.turso.io?auth_token=SEU_TOKEN
# DATABASE_URL=libsql://refugio-db-usuario.turso.io?authToken=SEU_TOKEN
#
# IMPORTANTE: Para Turso, rode o setup script ANTES de usar:
# DATABASE_URL="libsql://..." npx tsx scripts/setup-turso.ts --seed
#
# O código detecta automaticamente: file: → SQLite local, libsql:// → Turso via adapter

# ─── ADMIN PANEL ───
# Troque para algo seguro em produção! Mínimo 32 caracteres
ADMIN_SECRET=change-me-in-production-32char
NEXT_PUBLIC_ADMIN_EMAIL=admin@refugio.com

# ─── MERCADO PAGO (opcional — vazio = modo mock) ───
MERCADO_PAGO_ACCESS_TOKEN=

# ─── URL PÚBLICA ───
# Seu domínio na Vercel. Ex: https://refugiomataatlantica.com.br
NEXT_PUBLIC_BASE_URL=

# ─── RESEND (opcional — vazio = emails logados no console) ───
RESEND_API_KEY=
NOTIFICATION_EMAIL=reservas@refugiomataatlantica.com.br
RESEND_AUDIENCE_ID=
