# ─── DATABASE ───
DATABASE_URL=file:./db/custom.db

# ─── ADMIN PANEL ───
# Secret para assinar tokens JWT (troque em produção!)
ADMIN_SECRET=change-me-in-production-32char
# Email do admin padrão (usado no seed)
NEXT_PUBLIC_ADMIN_EMAIL=admin@refugio.com

# ─── MERCADO PAGO (opcional — deixe vazio para modo mock) ───
MERCADO_PAGO_ACCESS_TOKEN=

# ─── URL PÚBLICA ───
# Ex: https://seudominio.com.br (usado no sitemap e redirects MP)
NEXT_PUBLIC_BASE_URL=

# ─── RESEND (opcional — newsletter + contato por email) ───
RESEND_API_KEY=
NOTIFICATION_EMAIL=reservas@refugiomataatlantica.com.br
RESEND_AUDIENCE_ID=
