# ─── DATABASE ───
# Opção LOCAL (desenvolvimento):
DATABASE_URL=file:./db/custom.db
#
# Opção PRODUÇÃO na Vercel (Turso — SQLite cloud gratuito):
# 1. Crie em https://turso.tech (plano free)
# 2. Crie um database: turso db create refugio-db
# 3. Pegue a URL: turso db show refugio-db --url
# 4. Crie auth token: turso db tokens create refugio-db
#
# Na Vercel, configure ESTAS variáveis de ambiente:
#   DATABASE_URL=file:./placeholder.db          (para validação do schema Prisma)
#   TURSO_DATABASE_URL=libsql://refugio-db-xxx.turso.io   (sua URL Turso, sem token)
#   TURSO_AUTH_TOKEN=seu-token-aqui                      (token de autenticação)
#
# IMPORTANTE: Rode o setup script ANTES de usar na Vercel:
#   DATABASE_URL="libsql://...?auth_token=TOKEN" npx tsx scripts/setup-turso.ts --seed
#
# O código detecta automaticamente:
#   - Se TURSO_DATABASE_URL existe → usa adapter Turso
#   - Se DATABASE_URL é file: → SQLite local

# ─── ADMIN PANEL ───
# Troque para algo seguro em produção! Mínimo 32 caracteres
ADMIN_SECRET=change-me-in-production-32char
NEXT_PUBLIC_ADMIN_EMAIL=admin@refugio.com

# ─── MERCADO PAGO ───
# O modo mock fica restrito ao desenvolvimento. Em produção, configure o token.
MERCADO_PAGO_ACCESS_TOKEN=
# Opcional: valide assinaturas de webhook do Mercado Pago quando configurado.
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional: segredo independente para assinar consultas públicas de status de reserva.
# Se vazio, a aplicação deriva a chave do MERCADO_PAGO_ACCESS_TOKEN.
RESERVATION_STATUS_SECRET=

# ─── URL PÚBLICA ───
# Seu domínio na Vercel. Ex: https://refugiomataatlantica.com.br
NEXT_PUBLIC_BASE_URL=

# ─── RESEND (reservado; o fluxo atual não envia e-mails) ───
RESEND_API_KEY=
NOTIFICATION_EMAIL=reservas@refugiomataatlantica.com.br
RESEND_AUDIENCE_ID=
