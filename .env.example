# ─── DATABASE ───
# Opção LOCAL (desenvolvimento):
DATABASE_URL=file:./db/custom.db
#
# Opção PRODUÇÃO na Vercel (Turso — SQLite cloud gratuito):
# 1. Crie em https://turso.tech (plano free)
# 2. Crie um database: turso db create refugio-db
# 3. Pegue a URL: turso db show refugio-db --url
# 4. Crie auth token: turso db tokens create refugio-db
#
# Na Vercel, configure ESTAS variáveis de ambiente:
#   DATABASE_URL=file:./placeholder.db          (para validação do schema Prisma)
#   TURSO_DATABASE_URL=libsql://refugio-db-xxx.turso.io   (sua URL Turso, sem token)
#   TURSO_AUTH_TOKEN=seu-token-aqui                      (token de autenticação)
#
# IMPORTANTE: Rode o setup script ANTES de usar na Vercel:
#   DATABASE_URL="libsql://...?auth_token=TOKEN" npx tsx scripts/setup-turso.ts --seed
#
# O código detecta automaticamente:
#   - Se TURSO_DATABASE_URL existe → usa adapter Turso
#   - Se DATABASE_URL é file: → SQLite local

TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# ─── ADMIN PANEL ───
# Gere segredos aleatórios independentes com pelo menos 32 caracteres.
ADMIN_SECRET=
PLATFORM_ADMIN_SECRET=

# Domínio raiz que recebe os subdomínios das empresas (sem protocolo ou porta).
# example.com é reservado para documentação; substitua pelo domínio da plataforma.
# Local: use localhost e abra http://refugio-mata-atlantica.localhost:3000
# Produção: use o domínio raiz da plataforma, sem protocolo, porta ou barra final.
PLATFORM_BASE_DOMAIN=localhost

# Bootstrap opcional e não destrutivo usado pelo seed local.
# Defina ambos para criar a primeira identidade da equipe interna.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Perfil inicial do Refúgio, criado apenas se ainda não existir e se a senha estiver definida.
REFUGIO_ADMIN_EMAIL=
REFUGIO_ADMIN_PASSWORD=

# ─── MERCADO PAGO CONNECT (credenciais da aplicação da plataforma) ───
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Configure no painel da aplicação MP a permissão de acesso offline (offline_access)
# e o fluxo PKCE; cadastre a URL estática https://SEU_HOST/api/admin/mercadopago/callback.
MERCADO_PAGO_REDIRECT_URI=
# Chave AES-256 com 32 bytes em Base64 ou 64 caracteres hexadecimais.
MERCADO_PAGO_TOKEN_ENCRYPTION_KEY=
# Secret Signature configurada no painel de Webhooks da aplicação Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=
# Ativa checkout sem pagamento apenas em NODE_ENV=development; nunca confirma reservas.
MERCADO_PAGO_DEV_MOCK=false

# Credenciais separadas, reservadas para cobranças da assinatura SaaS da plataforma.
# Não são usadas para cobrar reservas das hospedagens.
PLATFORM_SAAS_MERCADO_PAGO_ACCESS_TOKEN=
# Secret Signature exclusivo configurado para /api/platform/billing/webhook.
PLATFORM_SAAS_MERCADO_PAGO_WEBHOOK_SECRET=

# Origem HTTPS canônica do painel/plataforma; callbacks não usam o Host da requisição.
PLATFORM_PUBLIC_ORIGIN=

# Gere com pelo menos 16 caracteres; o Vercel envia como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=


# ─── URL PÚBLICA ───
# URL pública HTTPS da plataforma usada para receber notificações MP.
NEXT_PUBLIC_BASE_URL=

# ─── RESEND (sem configuração, convites ficam pendentes para reenvio) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=reservas@refugiomataatlantica.com.br
RESEND_AUDIENCE_ID=
